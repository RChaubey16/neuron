# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Docker Compose loads this file into the containers.

# --- API ------------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=3000

# --- Database (Supabase dev project: Dashboard > Connect) ------------------
# Runtime connection: Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# Prisma Migrate: Session pooler (port 5432), or the Direct connection if
# your network has IPv6.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# --- Supabase Auth (Dashboard > Project Settings > Data API) --------------
# Project URL. Used to verify login tokens; not a secret.
SUPABASE_URL=https://<project-ref>.supabase.co

# Comma-separated origins allowed by CORS (the Neuron web app).
CORS_ORIGINS=http://localhost:3001
