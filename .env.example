# Copy to .env and fill in with your Supabase project's values.

# App
PORT=3000

# Supabase (Project Settings -> API)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Supabase Postgres connection string (Project Settings -> Database)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?schema=public"
