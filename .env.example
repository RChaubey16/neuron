# Copy to .env and adjust if the default ports clash with something on your machine.
# Docker Compose reads this file automatically.

# --- Local infrastructure (docker-compose.yml) ---
POSTGRES_USER=neuron
POSTGRES_PASSWORD=neuron
POSTGRES_DB=neuron
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Database (packages/db, apps/api) ---
# Must match the POSTGRES_* values above when using the local Docker Compose database.
DATABASE_URL=postgresql://neuron:neuron@localhost:5432/neuron

# --- Queue (apps/api, apps/worker) ---
# Must match REDIS_PORT above when using the local Docker Compose Redis.
REDIS_URL=redis://localhost:6379

# --- apps/api ---
API_PORT=4000

# Sender for every email. In production, use a domain verified in Resend.
EMAIL_FROM=Neuron <noreply@neuron.local>

# Dashboard origin: sign-in redirects back here, and it's the only origin allowed by CORS.
WEB_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials >
# Create credentials > OAuth client ID > Web application).
# Add GOOGLE_CALLBACK_URL exactly as an "Authorized redirect URI" on that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Signs session tokens and cookies. At least 32 characters: openssl rand -base64 48
SESSION_SECRET=

# Comma-separated Google account emails allowed to sign in.
ALLOWED_EMAILS=

# Set in production so the session cookie works on both the API and dashboard
# subdomains, e.g. .neuron.example.com. Leave unset locally.
# COOKIE_DOMAIN=

# --- apps/worker ---
# How many emails one worker process sends at the same time.
WORKER_CONCURRENCY=5

# Port of the worker's health check (GET /health). Internal only.
WORKER_HEALTH_PORT=4001

# Which provider sends email: smtp (Mailpit locally) or resend (production).
EMAIL_PROVIDER=smtp

# Resend API key with sending access, for EMAIL_PROVIDER=resend. Starts with re_.
# RESEND_API_KEY=

# SMTP server. Locally this is Mailpit: SMTP_PORT must match MAILPIT_SMTP_PORT above.
SMTP_HOST=localhost
SMTP_PORT=1025
# true for implicit TLS (usually port 465). STARTTLS is used automatically when offered.
SMTP_SECURE=false
# Set both, or neither (Mailpit needs no login).
# SMTP_USER=
# SMTP_PASSWORD=
